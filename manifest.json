{
  "manifest_version": 3,
  "name": "Insta Tools",
  "version": "1.0.0",
  "description": "Logs the reels you see on Instagram into copyable lists, and adds download buttons to post images, videos and reels.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging", "storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Insta Tools",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/bridge.js", "content/history.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/download.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
